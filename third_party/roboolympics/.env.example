# Copy to .env (gitignored) and fill in. Variable NAMES only; never commit values.
# The run scripts (scripts/olympiad/run_single.sh, run_duel.sh, run_round.py) pass .env to Harbor; the sim service's
# metering proxy (environment/sim/think_proxy.py) holds the model credentials, the agent seats never see them.

# Claude Code players (opus, fable): Claude subscription OAuth token(s)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_2=        # optional second subscription (scripts/olympiad/accounts.json, slot 2; needs .env.acct2)

# Codex players via OpenRouter (luna)
OPENROUTER_API_KEY=

# Codex players via Azure AI Foundry (astra; THINK_OPENAI_ROUTE=azure)
AZURE_AI_ENDPOINT=                # e.g. https://<resource>.services.ai.azure.com/models
AZURE_AI_API_KEY=
AZURE_DEPLOYMENTS=                # optional comma-separated replicas to fail over between

# Codex on a ChatGPT subscription (players astra-sub, sol-sub, luna-sub; players/harnesses/codex_chatgpt_think.py): the run
# scripts pass them to the *-sub seat's metering proxy only (CODEX_*_<seat>; CODEX_ENV_FILE overrides this file)
CODEX_ACCESS_TOKEN=
CODEX_ACCOUNT_ID=
